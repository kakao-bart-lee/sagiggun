{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "sagiggun-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ORIGIN_URL": "https://sagiggun-525484043977.asia-northeast3.run.app",
    "CANONICAL_HOST": "love.nngn.ai"
  },
  "routes": [
    {
      "pattern": "love.nngn.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
