DATABASE_URL=postgresql://postgres:postgres@localhost:15433/matching
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
OPENAI_API_KEY=sk-...
PHOTO_DIR=./.photos
# 확장 프로그램 API용 Bearer 토큰 (16자 이상). 비우면 Bearer 비활성.
OPS_API_TOKEN=
# live | mock — e2e는 mock
LLM_MODE=live
# anthropic | openai — 기본값 openai
LLM_PROVIDER=openai
# 비우면 OpenAI는 gpt-5.6-luna, Anthropic은 claude-sonnet-5 사용.
LLM_MODEL=
# low | medium | high
LLM_REASONING=high
# Cloud Run 사진 버킷. 비우면 PHOTO_DIR 로컬 파일.
PHOTO_BUCKET=
# 비우면 Threads 공식 origin 4개를 허용. 커스텀 확장 origin이 필요할 때만 설정.
# EXTENSION_CORS_ORIGINS=https://www.threads.com,https://threads.com
