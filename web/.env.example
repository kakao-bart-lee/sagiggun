DATABASE_URL=postgresql://postgres:postgres@localhost:15433/matching
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
OPENAI_API_KEY=sk-...
PHOTO_DIR=./.photos
# 확장 프로그램 API용 Bearer 토큰 (16자 이상). 비우면 Bearer 비활성.
OPS_API_TOKEN=
# live | mock — e2e는 mock
LLM_MODE=live
# anthropic | openai — 기본값 openai
LLM_PROVIDER=openai
# 비우면 OpenAI는 gpt-5.6-luna, Anthropic은 claude-sonnet-5 사용.
LLM_MODEL=
# low | medium | high
LLM_REASONING=high
# Secret Manager 기반 관리자 설정 UI (Cloud Run에서만 설정)
GCP_PROJECT_ID=
LLM_CONFIG_SECRET=sagiggun-llm-config
# Cloud Run 사진 버킷. 비우면 PHOTO_DIR 로컬 파일.
PHOTO_BUCKET=
# 비우면 Threads 공식 origin 4개를 허용. 커스텀 확장 origin이 필요할 때만 설정.
# EXTENSION_CORS_ORIGINS=https://www.threads.com,https://threads.com
# Threads Publishing API. 셋 다 없으면 관리자 설정의 "Threads 연결"이 503을 준다.
# Meta for Developers에서 앱 생성 → "Threads API" 제품 추가 → redirect URI 등록 후 발급.
THREADS_APP_ID=
THREADS_APP_SECRET=
# Meta 앱에 등록한 것과 정확히 같은 값(https 필수). 예: https://<도메인>/api/admin/threads/callback
THREADS_REDIRECT_URI=
# 로컬에서 ngrok 등 터널로 Threads OAuth를 테스트할 때만 설정. 터널 호스트(포트 제외)를
# 넣으면 next dev가 그 호스트로 오는 정적 자산·HMR 요청을 차단하지 않는다. 값이 없으면
# 기존 동작 그대로다. 예: xxxx.ngrok-free.dev
DEV_TUNNEL_HOST=
