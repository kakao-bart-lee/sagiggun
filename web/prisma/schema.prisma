generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  COLLECTED
  DRAFTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum MatchSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

enum DeliveryStatus {
  PENDING
  INSERTED
  DONE
  CANCELLED
}

model Profile {
  id     String @id @default(cuid())
  seq    Int?   @unique
  status Status @default(COLLECTED)

  // 원본 — 언제든 다시 처리할 수 있어야 한다
  sourceHandle String
  rawText      String @db.Text

  // 추출 결과
  gender              String?
  birthYear           Int?
  region              String?
  heightCm            Int?
  job                 String?
  hobbies             String[]
  appealPoints        String[]
  idealType           String[]
  partnerBirthYearMin Int?
  partnerBirthYearMax Int?
  partnerRegions      String[]
  dealBreakers        String[]

  // 작문 결과 — 게시 번호는 포함하지 않는다
  draftBody String? @db.Text
  finalBody String? @db.Text

  // 게시 (서브시스템 3)
  publishedPostId String?
  publishedAt     DateTime?

  photos Photo[]

  matchRunsAsSubject    MatchRun[]         @relation("MatchSubject")
  suggestionsAsCandidate MatchSuggestion[] @relation("SuggestionCandidate")
  deliveriesAsRecipient DeliveryItem[]     @relation("DeliveryRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceHandle])
  @@index([status])
}

model Photo {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  storageKey  String
  contentType String
  bytes       Int
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([profileId])
}

model MatchRun {
  id        String   @id @default(cuid())
  subjectId String
  subject   Profile  @relation("MatchSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  suggestions MatchSuggestion[]

  @@index([subjectId])
}

model MatchSuggestion {
  id                String                @id @default(cuid())
  runId             String
  run               MatchRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         Profile               @relation("SuggestionCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  rank              Int
  score             Float?
  rationale         String                @db.Text
  draftForSubject   String                @db.Text
  draftForCandidate String                @db.Text
  status            MatchSuggestionStatus @default(PENDING)

  deliveries DeliveryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([candidateId])
  @@index([status])
}

model DeliveryItem {
  id           String         @id @default(cuid())
  suggestionId String
  suggestion   MatchSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  toProfileId  String
  toProfile    Profile        @relation("DeliveryRecipient", fields: [toProfileId], references: [id], onDelete: Cascade)
  toHandle     String
  body         String         @db.Text
  status       DeliveryStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([suggestionId])
  @@index([toProfileId])
  @@index([status])
  @@index([toHandle])
}
